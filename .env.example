# Provider and Model settings
# PROPOSER_MODE: "mock" (reproducible deterministic test mode) or "live" (OpenAI / OpenRouter API)
PROPOSER_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Storage path
TASK_STORE_PATH=data/tasks.json
